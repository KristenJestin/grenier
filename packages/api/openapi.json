      "TypeDefinition": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the type, in lowercase kebab-case such as `bank-account`."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the type as people read it."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the type is and when to use it, in the words a user would say: agents choose a type from it."
          },
          "sensitive": {
            "type": "boolean",
            "description": "Every entry of the type is sensitive: shown only to a key with the right `sensitive`."
          },
          "read_in_parent": {
            "type": "boolean",
            "description": "Entries of the type that are part of an entry of the same type are read in that entry, with their fields, as the parts of a whole (the disks of a computer), rather than as entries of their own in the tree."
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldDefinition"
            },
            "description": "The fields of the type; none is a type with a title and a body only."
          }
        },
        "required": [
          "name",
          "label",
          "description",
          "fields"
        ],
        "additionalProperties": false
      },
      "FieldDefinition": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the field, in snake_case such as `monthly_cost`."
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "integer",
              "number",
              "boolean",
              "date",
              "datetime",
              "duration",
              "enum",
              "money",
              "url",
              "entry"
            ],
            "description": "What the field holds. `enum` needs its `values`; `entry` points to other entries (see `types`); `date` may carry `due` or `recurs`."
          },
          "required": {
            "type": "boolean",
            "description": "A write must give a value for the field (at least one when it is `many`)."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "For an `enum` field only: the values it accepts, at least one, without repeats."
          },
          "sensitive": {
            "type": "boolean",
            "description": "The values of the field are shown and written only by a key with the right `sensitive`."
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "On an `entry` field only: the names of the types its entries may be of, such as `[\"organization\"]`; a write naming an entry of another type is refused. Without it, any entry is accepted."
          },
          "many": {
            "type": "boolean",
            "description": "The field holds a list of values of its kind, in the order given and without duplicates, such as several sellers or languages; `required` then means at least one. Not with `due` or `recurs`."
          },
          "due": {
            "type": "object",
            "properties": {
              "notice": {
                "type": "string",
                "description": "How long before the date it is told as coming, an ISO 8601 duration such as `P60D` or `P2W`."
              }
            },
            "required": [
              "notice"
            ],
            "additionalProperties": false,
            "description": "For a `date` field only: the date is a deadline, told as coming `notice` before it."
          },
          "recurs": {
            "type": "object",
            "properties": {
              "every": {
                "type": "string",
                "enum": [
                  "yearly",
                  "monthly",
                  "weekly"
                ],
                "description": "How often the date comes back."
              },
              "notice": {
                "type": "string",
                "description": "How long before the date it is told as coming, an ISO 8601 duration such as `P60D` or `P2W`."
              }
            },
            "required": [
              "every",
              "notice"
            ],
            "additionalProperties": false,
            "description": "For a `date` field only: the date comes back, `every` year, month or week, told as coming `notice` before each time."
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "description": "A field of a type: its name, its kind and the rules a value of it follows."
      },
