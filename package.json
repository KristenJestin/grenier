{
  "name": "grenier",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "fmt": "oxfmt .",
    "fmt:check": "turbo run fmt:check",
    "test": "turbo run test",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.19.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "semantic-release": "25.0.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": []
}
