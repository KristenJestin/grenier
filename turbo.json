{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/tools/oxlint/**"],
      "outputs": []
    },
    "fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.ts"],
      "outputs": [],
      "env": ["DATABASE_URL", "SEARCH_LANGUAGE"]
    },
    "@grenier/tools#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**/*.ts",
        "$TURBO_ROOT$/apps/**/package.json",
        "$TURBO_ROOT$/packages/**/*.ts",
        "$TURBO_ROOT$/packages/**/package.json"
      ],
      "outputs": []
    },
    "@grenier/tools#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**/*.ts",
        "$TURBO_ROOT$/apps/**/package.json",
        "$TURBO_ROOT$/packages/**/*.ts",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/.githooks/**"
      ],
      "outputs": [],
      "env": ["DATABASE_URL"]
    }
  }
}
