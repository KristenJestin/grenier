{
  "name": "@grenier/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun --env-file=../../.env src/serve.ts",
    "mcp": "bun --env-file=../../.env src/mcp/main.ts",
    "grenier": "bun --env-file=../../.env src/cli.ts",
    "import": "bun --env-file=../../.env src/import/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "fmt:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "test": "bun --bun vitest run --config ../../vitest.config.ts --dir ."
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@grenier/api": "workspace:*",
    "@tanstack/react-router": "1.170.41",
    "better-auth": "1.7.7",
    "effect": "4.0.0",
    "file-type": "22.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "srvx": "1.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "1.7.7",
    "@tanstack/react-start": "1.168.60",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.3"
  }
}
