# Copy to .env. The local database of docker-compose.yml; never a database holding real data.
DATABASE_URL=postgres://grenier:grenier@127.0.0.1:55432/grenier
# The PostgreSQL text search configuration entries are searched with (simple, english, french…).
# Changing it needs no code change: the next migration run indexes the entries again.
SEARCH_LANGUAGE=simple
# Better Auth's secret, for the server only (the tests and the stdio MCP server do without it).
# Generate one with `openssl rand -base64 32`; never commit it.
BETTER_AUTH_SECRET=

# Which instance this is: `local` (this machine, throwaway data), `development` (the shared test
# server) or `production` (the owner's real data). Required: the server and the stdio MCP server
# refuse to start without it. The MCP server is announced as `grenier-local`, `grenier-dev` or
# `grenier`.
HIPPOCAMPE_INSTANCE=local
# A name to show for this instance, optional.
HIPPOCAMPE_INSTANCE_LABEL=
