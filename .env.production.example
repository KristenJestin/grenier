# The environment of the Grenier server in Docker. Copy this file to `.env.production`, next to
# `docker-compose.yml`, and fill in BETTER_AUTH_SECRET. `.env.production` holds a secret: it is
# ignored by git and must never be committed.

# The database of the `postgres` service. If you set POSTGRES_PASSWORD for compose, use it here.
DATABASE_URL=postgres://grenier:grenier@postgres:5432/grenier

# The port the server listens on inside the container (compose publishes it on GRENIER_PORT).
PORT=3000

# The time zone of the owner: "today" for deadlines, birthdays and briefings is the date there.
TZ=Europe/Paris

# The PostgreSQL text search configuration of the search: simple, english, french…
SEARCH_LANGUAGE=simple

# Better Auth's secret: a long random text, for example the output of `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Which instance this is: `production` (the owner's real data) or `development` (test data only).
# Required: the server and the stdio MCP server refuse to start without it. The MCP server is
# announced as `grenier` in production and `grenier-dev` in development.
GRENIER_INSTANCE=production
# A name to show for this instance, optional.
GRENIER_INSTANCE_LABEL=
