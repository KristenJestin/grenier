# The environment of the Grenier server in Docker. Copy this file to `.env.production`, next to
# `docker-compose.yml`, and fill in BETTER_AUTH_SECRET. `.env.production` holds a secret: it is
# ignored by git and must never be committed.

# The database of the `postgres` service. If you set POSTGRES_PASSWORD for compose, use it here.
DATABASE_URL=postgres://grenier:grenier@postgres:5432/grenier

# The port the server listens on inside the container (compose publishes it on HIPPOCAMPE_PORT).
PORT=3000

# The time zone of the owner: "today" for deadlines, birthdays and briefings is the date there.
TZ=Europe/Paris

# The PostgreSQL text search configuration of the search: simple, english, french…
SEARCH_LANGUAGE=simple

# Better Auth's secret: a long random text, for example the output of `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Which instance this is (`production`, `development` or `local`) is not set here: docker-compose.yml
# passes HIPPOCAMPE_INSTANCE from its own environment, `local` unless told, so a deployment says it
# explicitly, for example `HIPPOCAMPE_INSTANCE=production docker compose up -d`.

# A name to show for this instance, optional.
HIPPOCAMPE_INSTANCE_LABEL=

# The nightly Markdown export (see apps/server/src/export/): a git repository in EXPORT_DIR, one
# commit a night when something changed, sensitive data left out. Unset, no export runs.
EXPORT_DIR=/data/export
# Where to push it, and the deploy key that may (a file the container reads). The repository
# must be private. Unset, the export stays in the volume.
EXPORT_REMOTE=
EXPORT_DEPLOY_KEY_FILE=
# When, as a cron expression in TZ: every night at three by default.
EXPORT_SCHEDULE=0 3 * * *
